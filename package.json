{
  "name": "cryptohashes",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "pages:dev": "pnpm build && wrangler pages dev ./dist",
    "pages:deploy": "pnpm build && wrangler pages deploy ./dist --project-name cryptohashes",
    "pages:deploy:preview": "pnpm build && wrangler pages deploy ./dist --project-name cryptohashes --branch preview",
    "deploy": "pnpm pages:deploy"
  },
  "dependencies": {
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7",
    "wrangler": "4.98.0"
  }
}
